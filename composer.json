{
    "name": "phil/apisymfony",
    "description": "Start a REST API on Symfony and API Platform, with API keys, problem details, a checked OpenAPI document and every quality gate already passing.",
    "license": "MIT",
    "type": "project",
    "keywords": [
        "api",
        "api-platform",
        "openapi",
        "project-template",
        "rest",
        "symfony"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://ph-il.ca",
            "role": "Maintainer"
        },
        {
            "name": "COil (Strangebuzz)",
            "homepage": "https://www.strangebuzz.com",
            "role": "Author of strangebuzz/MicroSymfony, which this template derives from"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-dom": "*",
        "ext-iconv": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-simplexml": "*",
        "ext-xml": "*",
        "api-platform/doctrine-orm": "^5.0",
        "api-platform/metadata": "^5.0",
        "api-platform/openapi": "^5.0",
        "api-platform/symfony": "^5.0",
        "doctrine/dbal": "^4.6",
        "doctrine/doctrine-bundle": "^3.4",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/migrations": "^3.10",
        "doctrine/orm": "^3.8",
        "doctrine/persistence": "^4.2",
        "league/commonmark": "^2.10",
        "phil/api-contract": "^0.1@alpha",
        "phil/api-contract-bundle": "^0.3@alpha",
        "phil/api-keys-bundle": "^0.2@alpha",
        "phil/cors-bundle": "^0.1@alpha",
        "phil/idempotency": "^0.3@alpha",
        "sentry/sentry-symfony": "^5.17",
        "symfony/asset": "~8.2.0",
        "symfony/asset-mapper": "~8.2.0",
        "symfony/cache-contracts": "^3.8",
        "symfony/console": "~8.2.0",
        "symfony/doctrine-bridge": "~8.2.0",
        "symfony/dotenv": "~8.2.0",
        "symfony/expression-language": "~8.2.0",
        "symfony/filesystem": "~8.2.0",
        "symfony/flex": "^2.12",
        "symfony/framework-bundle": "~8.2.0",
        "symfony/http-foundation": "~8.2.0",
        "symfony/http-kernel": "~8.2.0",
        "symfony/intl": "~8.2.0",
        "symfony/monolog-bundle": "^4.1",
        "symfony/property-access": "~8.2.0",
        "symfony/property-info": "~8.2.0",
        "symfony/routing": "~8.2.0",
        "symfony/runtime": "~8.2.0",
        "symfony/security-bundle": "~8.2.0",
        "symfony/serializer": "~8.2.0",
        "symfony/stimulus-bundle": "^3.8",
        "symfony/string": "~8.2.0",
        "symfony/translation": "~8.2.0",
        "symfony/twig-bundle": "~8.2.0",
        "symfony/uid": "~8.2.0",
        "symfony/ux-turbo": "^3.8",
        "symfony/validator": "~8.2.0",
        "symfony/web-link": "~8.2.0",
        "symfony/yaml": "~8.2.0",
        "twig/extra-bundle": "^3.31",
        "twig/markdown-extra": "^3.31",
        "twig/twig": "^3.31"
    },
    "require-dev": {
        "api-platform/test": "^5.0",
        "bamarni/composer-bin-plugin": "^1.9",
        "brianium/paratest": "^7.30",
        "ergebnis/phpunit-slow-test-detector": "^2.29",
        "phil/dev-tools": "^0.2.1@alpha",
        "phpunit/phpunit": "^13.4",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "symfony/browser-kit": "~8.2.0",
        "symfony/css-selector": "~8.2.0",
        "symfony/debug-bundle": "~8.2.0",
        "symfony/http-client": "~8.2.0",
        "symfony/maker-bundle": "^1.68",
        "symfony/requirements-checker": "^2.0",
        "symfony/stopwatch": "~8.2.0",
        "symfony/web-profiler-bundle": "~8.2.0",
        "zenstruck/foundry": "^2.17"
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*",
        "symfony/polyfill-php85": "*"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../phil/packages/cors-bundle",
            "options": {
                "versions": {
                    "phil/cors-bundle": "0.1.0-alpha"
                }
            }
        },
        {
            "type": "path",
            "url": "../dev-tools",
            "options": {
                "versions": {
                    "phil/dev-tools": "0.2.1-alpha"
                }
            }
        }
    ],
    "minimum-stability": "beta",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true,
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "audit": {
            "abandoned": "fail",
            "block-insecure": true
        },
        "platform": {
            "php": "8.5.0"
        },
        "policy": {
            "advisories": {
                "block": true
            }
        },
        "process-timeout": 0,
        "sort-packages": true
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": false,
            "forward-command": true,
            "target-directory": "vendor-bin"
        },
        "symfony": {
            "allow-contrib": false,
            "require": "8.2.*"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "requirements-checker": "script",
            "importmap:install": "symfony-cmd"
        }
    }
}

# define your env variables for the test env here
#
# Note: .env.local is NOT loaded in the test environment, so this file is the right
# place to override the infrastructure configuration used by the test suite.
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# A dedicated SQLite file, so that running the test suite (the Foundry "ResetDatabase" trait drops the schema) never
# destroys the dev database. With MySQL or PostgreSQL, drop this line: the "dbname_suffix" of
# config/packages/doctrine.yaml takes over.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_test.db"

# The key of the hashes of the API tokens in the tests: known to everyone, for the tests only.
API_KEYS_HASH_KEY=test-key-of-the-api-tokens-not-a-secret-either

SYMFONY_DEPRECATIONS_HELPER=999999

###> symfony/panther ###
# The E2E suite: Panther serves the application in the test environment and keeps a screenshot of each failure.
PANTHER_APP_ENV=test
PANTHER_ERROR_SCREENSHOT_DIR=./var/error-screenshots
PANTHER_DEVTOOLS=0
###< symfony/panther ###
